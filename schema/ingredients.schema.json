{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RashKash103/get-cooked/main/schema/ingredients.schema.json",
  "title": "get-cooked ingredient database",
  "description": "Maps ingredient keys to names, conversions and rounding rules.",
  "type": "object",
  "additionalProperties": {
    "$ref": "#/$defs/entry"
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name (singular). Defaults to the key with dashes as spaces."
        },
        "plural": {
          "type": "string",
          "description": "Plural name, used for counted items (\"3 eggs\")."
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other names used to auto-match recipe ingredients."
        },
        "density": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "description": "Density, enabling mass ⇄ volume conversion, e.g. {value: 125, unit: g/cup} or {value: 1.03, unit: g/ml}.",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "enum": [
                "g/ml",
                "g/cm3",
                "g/l",
                "kg/l",
                "kg/m3",
                "g/tsp",
                "g/tbsp",
                "g/cup",
                "oz/tbsp",
                "oz/cup",
                "oz/floz",
                "oz/pint",
                "lb/cup",
                "lb/pint",
                "lb/quart",
                "lb/gal"
              ],
              "description": "Mass per volume."
            }
          }
        },
        "grams_each": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Weight of one item (e.g. one egg)."
        },
        "unit_grams": {
          "type": "object",
          "description": "Weight of one count unit, e.g. {stick: 113, clove: 5}.",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "ladder": {
          "type": "array",
          "minItems": 0,
          "description": "How to show this ingredient in US units, replacing the tsp/tbsp/cup ladder: volume units and counted units with unit_grams (e.g. [tsp, tbsp, {unit: stick, denoms: [2], min: 0.5}] shows 8 tbsp as 1 stick and ⅛ stick as 1 tbsp). Each step is a unit name, or a unit with its own rounding. Needs a density when it mixes counted units with volumes. An empty list turns an inherited ladder off.",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "unit"
                ],
                "properties": {
                  "unit": {
                    "type": "string"
                  },
                  "denoms": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "description": "Round to fractions with these denominators."
                  },
                  "tiers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "below": {
                          "type": "number"
                        },
                        "step": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": [
                        "step"
                      ]
                    },
                    "description": "Round to decimal steps by size."
                  },
                  "min": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Smallest amount to show in this unit."
                  },
                  "max": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Above this, show the next unit up plus a remainder (\"1 stick + 2 tbsp\")."
                  },
                  "tiny": {
                    "type": "string",
                    "description": "Label when a positive amount rounds to zero (\"pinch\")."
                  }
                }
              }
            ]
          }
        },
        "measure": {
          "enum": [
            "volume",
            "mass"
          ],
          "description": "Show this ingredient by weight (mass) or volume in every unit system when its density is known. Without it, metric shows weight and other systems keep the written dimension."
        },
        "round": {
          "type": "object",
          "additionalProperties": false,
          "description": "Rounding for counted amounts, e.g. eggs {step: 1, min: 1}.",
          "properties": {
            "denoms": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              }
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "min": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "category": {
          "type": "string",
          "description": "Shopping category (produce, dairy, baking…)."
        }
      }
    }
  }
}
