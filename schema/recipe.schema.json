{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RashKash103/get-cooked/main/schema/recipe.schema.json",
  "title": "get-cooked recipe",
  "description": "A get-cooked recipe. See docs/recipe-format.md for the full reference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "servings",
    "ingredients",
    "steps"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Recipe title."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "URL slug. Defaults to the file name."
    },
    "description": {
      "type": "string",
      "description": "One or two sentences shown under the title and on cards."
    },
    "image": {
      "type": "string",
      "description": "Image path relative to the recipe file, or an absolute URL."
    },
    "image_alt": {
      "type": "string",
      "description": "Alt text for the image. Defaults to the title."
    },
    "category": {
      "type": "string",
      "description": "Category. Defaults to the parent directory name."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "cuisine": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "pdf": {
          "type": "string",
          "pattern": "\\.[pP][dD][fF]$",
          "description": "A PDF in the site: a path next to the recipe file, or from the site folder with a leading /. Opens in the built-in viewer."
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "description": "The page the recipe is on. With pdf: the PDF page to open (counting from the first page of the file)."
        },
        "credit": {
          "type": "string",
          "description": "A line shown instead of \"Source: …\", e.g. \"Adapted from {source}\". {source} is replaced by the linked name and {page} by the page; without {source} the link follows the text."
        }
      }
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD, used for sorting newest first."
    },
    "draft": {
      "type": "boolean",
      "description": "Drafts are only built with --drafts."
    },
    "servings": {
      "description": "Servings control. A number is shorthand for {default: N}.",
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default"
          ],
          "properties": {
            "default": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "The amount the recipe is written for."
            },
            "min": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "type": "string",
              "description": "What is being counted, singular (e.g. 'bar', 'loaf'). Default 'serving'."
            },
            "plural": {
              "type": "string",
              "description": "Plural of unit. Default unit + 's'."
            }
          }
        }
      ]
    },
    "scaling": {
      "$ref": "#/$defs/expr",
      "description": "Expression overriding the scale factor (default servings / servings.default)."
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "vars": {
      "type": "object",
      "description": "Computed variables, usable in any expression. Values are expressions.",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/expr"
      }
    },
    "times": {
      "type": "object",
      "description": "Times in minutes (numbers or expressions). Common keys: prep, cook, rest, total. 'total' defaults to the sum of the others.",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/expr"
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/equipment"
      }
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "if": {
          "type": "object",
          "anyOf": [
            {
              "required": [
                "items"
              ]
            },
            {
              "required": [
                "section"
              ]
            }
          ]
        },
        "then": {
          "$ref": "#/$defs/ingredientSection"
        },
        "else": {
          "$ref": "#/$defs/ingredient"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "if": {
          "type": "object",
          "anyOf": [
            {
              "required": [
                "steps"
              ]
            },
            {
              "required": [
                "section"
              ]
            }
          ]
        },
        "then": {
          "$ref": "#/$defs/stepSection"
        },
        "else": {
          "$ref": "#/$defs/step"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "ingredient_db": {
      "type": "object",
      "description": "Recipe-local ingredient database entries (same format as ingredients.yaml).",
      "additionalProperties": {
        "$ref": "ingredients.schema.json#/$defs/entry"
      }
    },
    "images": {
      "type": "array",
      "description": "Image variants for the recipe page: the first whose `when` matches replaces `image` (which stays the default on the index and in previews).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "src",
          "when"
        ],
        "properties": {
          "src": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "when": {
            "$ref": "#/$defs/when"
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "expr": {
      "description": "An expression: a number, boolean, or a string such as \"30 + servings * 2\".",
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "when": {
      "description": "Condition expression; the item is included only when it is true.",
      "type": [
        "string",
        "boolean"
      ]
    },
    "template": {
      "type": "string",
      "description": "Text with {expr}, {expr | fmt}, {if c}…{else}…{end}, @ingredient, @ingredient{portion}, @ingredient{-}, #equipment and ~{minutes}."
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "toggle",
            "choice",
            "number"
          ]
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "default": {
          "type": [
            "boolean",
            "string",
            "number"
          ]
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/identifier"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/when"
        }
      }
    },
    "equipment": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "name": {
              "$ref": "#/$defs/template"
            },
            "note": {
              "$ref": "#/$defs/template"
            },
            "when": {
              "$ref": "#/$defs/when"
            }
          }
        }
      ]
    },
    "ingredient": {
      "oneOf": [
        {
          "type": "string",
          "description": "Shorthand like \"2 1/4 cups flour, sifted\"."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "ingredient": {
              "type": "string",
              "description": "Key in the ingredient database (ingredients.yaml)."
            },
            "name": {
              "type": "string",
              "description": "Display name. Defaults to the database name."
            },
            "plural": {
              "type": "string"
            },
            "amount": {
              "description": "A number scales with servings; a string is a raw expression (not auto-scaled); [low, high] is a range such as [1, 2] cloves.",
              "oneOf": [
                {
                  "$ref": "#/$defs/expr"
                },
                {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": [
                      "number",
                      "string"
                    ]
                  }
                }
              ]
            },
            "unit": {
              "type": "string"
            },
            "scale": {
              "type": "boolean",
              "description": "Set false to keep a numeric amount fixed."
            },
            "fixed_unit": {
              "type": "boolean",
              "description": "Never change the unit (no ladders or system conversion)."
            },
            "note": {
              "$ref": "#/$defs/template"
            },
            "when": {
              "$ref": "#/$defs/when"
            },
            "optional": {
              "type": "boolean",
              "description": "Creates a toggle option with this ingredient's id."
            },
            "default": {
              "type": "boolean",
              "description": "Default state of the optional toggle."
            },
            "option_label": {
              "type": "string"
            },
            "recipe": {
              "type": "string",
              "description": "Slug of another recipe used as a prerequisite. amount is in that recipe's servings unit and the ingredient links to it."
            },
            "with": {
              "type": "object",
              "description": "Options to set on the linked recipe, e.g. {dairy_free: vegan}. Values are expressions.",
              "propertyNames": {
                "$ref": "#/$defs/identifier"
              },
              "additionalProperties": {
                "$ref": "#/$defs/expr"
              }
            },
            "split": {
              "type": "object",
              "minProperties": 2,
              "description": "Named portions used in different steps, e.g. {dough: 4, topping: 2}. The total is their sum; reference a portion as @id.name. Numbers scale with servings; strings are expressions.",
              "propertyNames": {
                "$ref": "#/$defs/identifier"
              },
              "additionalProperties": {
                "$ref": "#/$defs/expr"
              }
            },
            "density": {
              "$ref": "ingredients.schema.json#/$defs/entry/properties/density"
            },
            "grams_each": {
              "$ref": "ingredients.schema.json#/$defs/entry/properties/grams_each"
            },
            "unit_grams": {
              "$ref": "ingredients.schema.json#/$defs/entry/properties/unit_grams"
            },
            "measure": {
              "$ref": "ingredients.schema.json#/$defs/entry/properties/measure",
              "description": "Override: show this ingredient by weight (mass) or volume in every unit system, when its density is known."
            },
            "round": {
              "$ref": "ingredients.schema.json#/$defs/entry/properties/round"
            },
            "category": {
              "$ref": "ingredients.schema.json#/$defs/entry/properties/category"
            },
            "subs": {
              "type": "array",
              "minItems": 1,
              "description": "Substitutes the reader can swap in with the Swap button (option swap_<id>, whose choices are the ingredient keys or names). Each shares this ingredient's id and uses its amount and unit unless it gives its own; `ratio` multiplies the inherited amount. A list (or {label, items}) is a combination of several ingredients, e.g. milk + lemon juice for buttermilk.",
              "items": {
                "$ref": "#/$defs/substitute"
              }
            },
            "ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Substitutes only: multiply the inherited amount, e.g. 0.5."
            }
          },
          "anyOf": [
            {
              "required": [
                "id"
              ]
            },
            {
              "required": [
                "ingredient"
              ]
            },
            {
              "required": [
                "name"
              ]
            },
            {
              "required": [
                "recipe"
              ]
            }
          ]
        }
      ]
    },
    "ingredientSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "section": {
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ingredient"
          }
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/template"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "$ref": "#/$defs/template"
            },
            "when": {
              "$ref": "#/$defs/when"
            },
            "note": {
              "$ref": "#/$defs/template"
            },
            "image": {
              "type": "string"
            }
          }
        }
      ]
    },
    "stepSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "section": {
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "note": {
      "oneOf": [
        {
          "$ref": "#/$defs/template"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "$ref": "#/$defs/template"
            },
            "when": {
              "$ref": "#/$defs/when"
            },
            "kind": {
              "enum": [
                "info",
                "tip",
                "warning"
              ]
            }
          }
        }
      ]
    },
    "substitute": {
      "description": "A substitute: an ingredient (shorthand or mapping), or a combination of ingredients that replace it together, as a list or {label, items}. A combination's first part takes the ingredient's place; the others get ids like <id>_<ingredient> and are named wherever the text says @<id>.",
      "oneOf": [
        {
          "$ref": "#/$defs/ingredient"
        },
        {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/ingredient"
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items"
          ],
          "properties": {
            "label": {
              "type": "string",
              "description": "Name in the swap menu (default: the parts' names joined with +)."
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/ingredient"
              }
            }
          }
        }
      ]
    }
  }
}
